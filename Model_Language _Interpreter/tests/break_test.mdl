program
{
	int x = 5;
	int i;
	for (i=0; i<=9999; i++)
	{
		x = x * 2;
		if (i >= 5)
			break;
	}
	writeline("x = ", x);
	writeline("i = ", i);
	writeline(" ");

	x = 0; 
	int j;
	for (j=0; j<10; j++)
	{
		x = x + 2;
		for (i=0; i<=9999; i++)
		{
			x = x + 2;
			if (i >= 5)
				break;
		}
	}
	writeline("x = ", x);
	writeline("i = ", i);
	writeline("j = ", j);
}