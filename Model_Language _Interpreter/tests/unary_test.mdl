program
{
    int x = 1;
    x++; 
    writeline("x = 1, x++ = ", x);
    x--;
    writeline("x = 2, x-- = ", x);

    ++x;
    writeline("x = 1, ++x = ", x);
    --x;
    writeline("x = 2, --x = ", x);
    writeline(" ");

    int y = 5 + x++;
    writeline("x = 1, (5 + x++) = ", y);
    y = 5 + x--;
    writeline("x = 2, (5 + x--) = ", y);

    y = 5 + ++x;
    writeline("x = 1, (5 + ++x) = ", y);
    y = 5 + --x;
    writeline("x = 2, (5 + --x) = ", y);
}