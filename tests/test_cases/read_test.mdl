program
{
	int x;
	real y;
	string s;
	bool b;
	
	write("Enter any integer value: ");
	read(x);

	writeline(" ");
	write("Enter any real value: ");
	read(y);
	
	writeline(" ");
	write("Enter any string value: ");
	read(s);
	
	writeline(" ");
	write("Enter any boolean value ('true' or 'false'): ");
	read(b);

	writeline(" ");
	writeline("Your integer value: ", x);
	writeline("Your real value: ", y);
	writeline("Your string value: ", s);
	writeline("Your boolean value: ", b);
}